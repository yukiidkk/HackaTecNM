# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas ".env" a git. El líder del equipo distribuye las credenciales
# por un canal privado (WhatsApp, Notion, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# ── Kafka / Redpanda ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=inventory-service

# ── Base de Datos (Supabase / PostgreSQL) ─────────────────────────────────────
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase (cliente Python supabase-py) ─────────────────────────────────────
# SUPABASE_URL: URL del proyecto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY: service_role secret (Project Settings → API → service_role) — NUNCA la anon key
SUPABASE_KEY=your-supabase-service-role-key-here

# ── Inventario ────────────────────────────────────────────────────────────────
DEFAULT_STOCK_LOCATION_ID=100   # location_id de U-100

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
